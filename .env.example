# ==============================================
# Obrigatório — Application
# ==============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==============================================
# Obrigatório — Firebase Client (Public)
# ==============================================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ==============================================
# Obrigatório — Firebase Admin (Server)
# ==============================================
# JSON da service account convertido para base64:
# cat service-account.json | base64 | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_KEY=

# ==============================================
# Obrigatório — Segurança
# ==============================================
# Protege os endpoints de cron. Gere com: openssl rand -base64 32
CRON_SECRET=

# Chave usada para cifrar credenciais por usuário (AES-256-GCM).
# Gere com: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=

# ==============================================
# Opcional — Email global de notificações
# ==============================================
# Se não configurar email, o app segue funcionando e apenas registra erro no log
# ao tentar enviar email. GitHub e Telegram são configurados por usuário no dashboard.
RESEND_API_KEY=
RESEND_FROM=
NOTIFICATION_EMAIL_TO=
NOTIFICATION_EMAIL_FROM=

# Alternativa ao Resend: SMTP
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
